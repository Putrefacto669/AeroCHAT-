@model ChatViewModel
@{
  ViewData["Title"] = "Chat — " + Model.Recipient.DisplayName;
  ViewBag.SidebarActiveId = Model.Recipient.Id;
  var c = System.Globalization.CultureInfo.GetCultureInfo("es-GT");
}

<div class="app-shell">
  @await Html.PartialAsync("_Sidebar")

  <div class="chat-main">
    <div class="chat-header">
      <button class="hamburger" onclick="openSidebar()" aria-label="Menú">☰</button>
      <a href="/Profile/Index/@Model.Recipient.Id" class="chat-header-link">
        @if (!string.IsNullOrEmpty(Model.Recipient.AvatarPath))
        {
          <img src="@Model.Recipient.AvatarPath" class="avatar avatar-md" alt=""/>
        }
        else
        {
          <span class="avatar avatar-md" style="background:@Model.Recipient.AvatarColor">@Model.Recipient.DisplayName[0]</span>
        }
        <div class="chat-header-info">
          <div class="chat-header-name">
            @Model.Recipient.DisplayName
            <span class="presence-dot" id="headerDot" data-userid="@Model.Recipient.Id"></span>
          </div>
          <div class="chat-header-sub" id="headerSub">
            @(!string.IsNullOrEmpty(Model.Recipient.Status) ? Model.Recipient.Status : $"@{Model.Recipient.Username}")
          </div>
        </div>
      </a>
      <button class="icon-btn" title="Buscar" onclick="toggleSearch()">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <button class="icon-btn icon-btn-call" title="Llamada de voz"
              onclick="callFriend('@Model.Recipient.Id','@JavaScriptEncoder.Default.Encode(Model.Recipient.DisplayName)','@Model.Recipient.AvatarPath','@Model.Recipient.AvatarColor','audio')">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </button>
      <button class="icon-btn icon-btn-call icon-btn-video" title="Videollamada"
              onclick="callFriend('@Model.Recipient.Id','@JavaScriptEncoder.Default.Encode(Model.Recipient.DisplayName)','@Model.Recipient.AvatarPath','@Model.Recipient.AvatarColor','video')">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      </button>
    </div>

    <div class="search-panel" id="searchPanel" hidden>
      <div class="search-panel-head">
        <span class="search-ic">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="text" id="searchInput" placeholder="Buscar en la conversación…" autocomplete="off"/>
        <span class="search-count" id="searchCount" hidden></span>
        <button type="button" class="icon-btn icon-btn-clear" onclick="closeSearch()" title="Cerrar">✕</button>
      </div>
      <div class="search-panel-results" id="searchResults"></div>
    </div>

    @if (TempData["Error"] != null)
    {
      <div class="alert-error" style="margin:0 16px 0">@TempData["Error"]</div>
    }

    <div class="messages-area" id="messages">
      @if (!Model.Messages.Any())
      {
        <div class="no-messages">Nada por acá todavía — ¡arrancá la conversación!</div>
      }

      @{ string? lastDate = null; }
      @foreach (var msg in Model.Messages)
      {
        lastDate = RenderMessage(msg, Model.CurrentUser, Model.Recipient, lastDate, c);
      }
    </div>

    <div class="input-area">
      <div class="attach-panel" id="attachPanel">
        <div class="attach-options">
          <form method="post" action="/Chat/SendFile" enctype="multipart/form-data">
            <input type="hidden" name="receiverId" value="@Model.Recipient.Id"/>
            <label class="attach-opt">🖼 Imagen<input type="file" name="file" accept="image/*" onchange="this.form.submit()"/></label>
          </form>
          <form method="post" action="/Chat/SendFile" enctype="multipart/form-data">
            <input type="hidden" name="receiverId" value="@Model.Recipient.Id"/>
            <label class="attach-opt">🎵 Audio<input type="file" name="file" accept="audio/*" onchange="this.form.submit()"/></label>
          </form>
          <form method="post" action="/Chat/SendFile" enctype="multipart/form-data">
            <input type="hidden" name="receiverId" value="@Model.Recipient.Id"/>
            <label class="attach-opt">🎬 Video<input type="file" name="file" accept="video/*" onchange="this.form.submit()"/></label>
          </form>
          <form method="post" action="/Chat/SendFile" enctype="multipart/form-data">
            <input type="hidden" name="receiverId" value="@Model.Recipient.Id"/>
            <label class="attach-opt">📄 Documento<input type="file" name="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip" onchange="this.form.submit()"/></label>
          </form>
        </div>
      </div>

      <div class="reply-bar" id="replyBar"></div>

      <div class="sticker-panel" id="stickerPanel" hidden>
        <div class="sticker-import">
          <input type="text" id="stickerLink" placeholder="Pega el link del paquete sticker.ly…" autocomplete="off"/>
          <button type="button" class="sticker-import-btn" onclick="importStickerPack()">Importar</button>
        </div>
        <div class="sticker-panel-body" id="stickerPanelBody"></div>
      </div>

      <div class="send-form" id="sendForm">
        <button type="button" class="icon-btn icon-btn-attach" onclick="toggleAttach()" title="Adjuntar">📎</button>
        <button type="button" class="icon-btn icon-btn-sticker" onclick="toggleStickers()" title="Stickers">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.5 3H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2V8.5L15.5 3z"/><path d="M15 3v6h6"/><path d="M7 13h10"/><path d="M7 17h7"/></svg>
        </button>
        <input type="text" id="msgInput" placeholder="Mensaje…" autocomplete="off" class="msg-input"/>
        <button class="icon-btn icon-btn-send" id="sendBtn" title="Enviar">➤</button>
      </div>
      <div id="typingIndicator" class="typing-indicator"></div>
    </div>
  </div>
</div>

@functions {
  string? RenderMessage(Message msg, User me, User them, string? lastDate, System.Globalization.CultureInfo c)
  {
    var dateStr = msg.CreatedAt.ToString("dd 'de' MMMM", c);
    if (dateStr != lastDate)
    {
      <div class="date-divider" data-date="@msg.CreatedAt.ToString("yyyy-MM-dd")">@dateStr</div>
      lastDate = dateStr;
    }

    var isMine = msg.SenderId == me.Id;
    var side = isMine ? "mine" : "theirs";
    var sender = isMine ? me : them;
    var preview = msg.Type == MessageType.Text
        ? (msg.Content.Length > 40 ? msg.Content.Substring(0, 40) + "…" : msg.Content)
        : "[" + msg.Type.ToString().ToLower() + "]";

    <div class="msg-row @side" data-id="@msg.Id">
      @if (!isMine)
      {
        <a href="/Profile/Index/@sender.Id">
          @if (!string.IsNullOrEmpty(sender.AvatarPath))
          {
            <img src="@sender.AvatarPath" class="avatar avatar-sm" alt=""/>
          }
          else
          {
            <span class="avatar avatar-sm" style="background:@msg.SenderColor">@msg.SenderName[0]</span>
          }
        </a>
      }

      <div class="bubble @side @(msg.IsDeleted ? "deleted" : "") @msg.Type.ToString().ToLower()">
        @if (!string.IsNullOrEmpty(msg.ReplyToId))
        {
          <div class="msg-reply">
            <span class="msg-reply-sender">@JavaScriptEncoder.Default.Encode(msg.ReplyToSender ?? "")</span>
            <span class="msg-reply-content">@JavaScriptEncoder.Default.Encode(msg.ReplyToContent ?? "")</span>
          </div>
        }
        @if (msg.Type == MessageType.Text)
        {
          <span class="msg-text">@msg.Content</span>
        }
        else if (msg.Type == MessageType.Image)
        {
          <img src="@msg.FilePath" alt="@msg.FileName" class="msg-image" onclick="openLightbox(this)"/>
        }
        else if (msg.Type == MessageType.Sticker)
        {
          <img src="@msg.FilePath" class="msg-sticker" alt="sticker"/>
        }
        else if (msg.Type == MessageType.Audio)
        {
          <div class="msg-audio">
            <span class="file-icon">🎵</span>
            <div><div class="file-name">@msg.FileName</div><audio controls src="@msg.FilePath"></audio></div>
          </div>
        }
        else if (msg.Type == MessageType.Video)
        {
          <div class="msg-video">
            <video controls preload="metadata" src="@msg.FilePath"></video>
            <div class="file-name">@msg.FileName</div>
          </div>
        }
        else
        {
          <div class="msg-doc">
            <span class="file-icon">📄</span>
            <div>
              <div class="file-name">@msg.FileName</div>
              <a href="@msg.FilePath" download="@msg.FileName" class="file-download">Descargar</a>
            </div>
          </div>
        }

        <div class="msg-meta">
          @if (msg.EditedAt.HasValue) { <span class="msg-edited">editado</span> }
          <span class="msg-time">@msg.CreatedAt.ToString("HH:mm")</span>
          @if (isMine && !msg.IsDeleted)
          {
            <span class="msg-seen">@(msg.ReadBy.Contains(them.Id) ? "✓✓" : "✓")</span>
          }
        </div>

        @if (!msg.IsDeleted)
        {
          <div class="msg-reactions">
            @foreach (var grp in msg.Reactions.GroupBy(r => r.Emoji))
            {
              var mine = grp.Any(r => r.UserId == me.Id);
              <button class="reaction-chip@(mine ? " mine" : "")" data-emoji="@grp.Key" onclick="toggleReaction('@msg.Id','@grp.Key')">
                <span class="rc-emoji">@grp.Key</span><span class="rc-count">@grp.Count()</span>
              </button>
            }
            <button class="reaction-add" title="Reaccionar" onclick="openReactionPicker('@msg.Id', event)">＋</button>
          </div>

          <div class="msg-actions">
            <button class="action-btn" title="Responder" onclick="respondTo('@msg.Id','@JavaScriptEncoder.Default.Encode(msg.SenderName)','@JavaScriptEncoder.Default.Encode(preview)')">↩</button>
            @if (isMine)
            {
              @if (msg.Type == MessageType.Text)
              {
                <button class="action-btn" onclick="openEdit('@msg.Id','@JavaScriptEncoder.Default.Encode(msg.Content)')">✏</button>
              }
              <button class="action-btn del" onclick="confirmDelete('@msg.Id')">🗑</button>
            }
          </div>
        }
      </div>
    </div>
    return lastDate;
  }
}

<!-- Edit modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <h3>Editar mensaje</h3>
    <div>
      <input type="hidden" id="editMsgId"/>
      <textarea id="editContent" class="edit-textarea"></textarea>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="submitEdit()">Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal">
    <h3>Eliminar mensaje</h3>
    <p>Esta acción no se puede deshacer.</p>
    <div>
      <input type="hidden" id="deleteMsgId"/>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancelar</button>
        <button type="button" class="btn btn-danger" onclick="submitDelete()">Eliminar</button>
      </div>
    </div>
  </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <img id="lightboxImg" src="" alt=""/>
</div>

@section Scripts {
<script>
  // ── State ──
  var currentUserId = '@Model.CurrentUser.Id';
  var recipientId = '@Model.Recipient.Id';
  var recipientName = '@JavaScriptEncoder.Default.Encode(Model.Recipient.DisplayName)';
  var myName = '@JavaScriptEncoder.Default.Encode(Model.CurrentUser.DisplayName)';
  var myColor = '@Model.CurrentUser.AvatarColor';
  var myAvatar = '@Model.CurrentUser.AvatarPath';
  var theirAvatar = '@Model.Recipient.AvatarPath';
  var theirStatus = '@JavaScriptEncoder.Default.Encode(!string.IsNullOrEmpty(Model.Recipient.Status) ? Model.Recipient.Status : ("@" + Model.Recipient.Username))';
  var typingTimer = null;
  var replyTo = null;

  // ── Chat handlers (hub global) ──
  function registerChatHandlers(hub) {
    hub.on('ReceiveMessage', function (msg) {
      addMessage(msg);
      scrollToBottom();
      acInvoke('MarkRead', recipientId);
      refreshSidebar();
    });

    hub.on('MessageEdited', function (messageId, newContent, editedAt) {
      var el = document.querySelector('.msg-row[data-id="' + messageId + '"]');
      if (!el) return;
      var text = el.querySelector('.msg-text');
      if (text) text.textContent = newContent;
      var meta = el.querySelector('.msg-meta');
      if (meta && !meta.querySelector('.msg-edited')) {
        var span = document.createElement('span');
        span.className = 'msg-edited';
        span.textContent = 'editado';
        meta.insertBefore(span, meta.firstChild);
      }
    });

    hub.on('MessageDeleted', function (messageId) {
      var el = document.querySelector('.msg-row[data-id="' + messageId + '"]');
      if (!el) return;
      var actions = el.querySelector('.msg-actions');
      if (actions) actions.remove();
      var reactions = el.querySelector('.msg-reactions');
      if (reactions) reactions.remove();
      var bubble = el.querySelector('.bubble');
      if (bubble) {
        bubble.classList.add('deleted');
        bubble.innerHTML = '<span class="msg-text">Mensaje eliminado</span><div class="msg-meta"></div>';
      }
    });

    hub.on('MessageReacted', function (messageId, emoji, userId, added, count) {
      applyReaction(messageId, emoji, userId, added, count);
    });

    hub.on('MessagesRead', function (readerId, otherId) {
      if (readerId !== recipientId) return;
      document.querySelectorAll('.msg-row.mine .msg-seen').forEach(function (s) { s.textContent = '✓✓'; });
    });

    hub.on('SearchResults', function (results) {
      renderSearchResults(results || []);
    });

    hub.on('UserTyping', function (userId, displayName) {
      if (userId === currentUserId) return;
      var ind = document.getElementById('typingIndicator');
      if (ind) ind.textContent = displayName + ' está escribiendo…';
    });

    hub.on('UserStoppedTyping', function (userId) {
      if (userId === currentUserId) return;
      var ind = document.getElementById('typingIndicator');
      if (ind) ind.textContent = '';
    });
  }

  // ── Presencia en el header ──
  function renderPresence() {
    var online = !!window.acOnlineUsers[recipientId];
    var sub = document.getElementById('headerSub');
    if (sub) sub.textContent = online ? 'en línea' : theirStatus;
    var dot = document.getElementById('headerDot');
    if (dot) dot.classList.toggle('online', online);
  }
  document.addEventListener('ac:presence', renderPresence);

  // ── Unirse a la conversación cuando el hub esté listo ──
  function joinConversation() {
    if (window.acHub) {
      window.acHub.invoke('JoinConversation', recipientId).catch(function () {});
      acInvoke('MarkRead', recipientId);
      refreshSidebar();
    }
  }
  document.addEventListener('ac:hubconnected', joinConversation);

  if (window.acHub) {
    registerChatHandlers(window.acHub);
    if (window.acHub.state === 'Connected') joinConversation();
  }

  // ── Send message ──
  document.getElementById('sendBtn').addEventListener('click', sendMessage);
  document.getElementById('msgInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  document.getElementById('msgInput').addEventListener('input', function () {
    if (typingTimer) clearTimeout(typingTimer);
    acInvoke('Typing', recipientId, myName);
    typingTimer = setTimeout(function () {
      acInvoke('StopTyping', recipientId);
    }, 1200);
  });

  function sendMessage() {
    var input = document.getElementById('msgInput');
    var content = input.value.trim();
    if (!content) return;
    input.value = '';
    var rid = replyTo ? replyTo.id : null;
    acInvoke('SendMessage', recipientId, content, rid);
    cancelReply();
  }

  // ── Responder (citar) ──
  function respondTo(id, name, content) {
    replyTo = { id: id, name: name, content: content };
    var bar = document.getElementById('replyBar');
    if (!bar) return;
    bar.innerHTML = '<span class="reply-bar-label">↩ ' + htmlEncode(name) + '</span>'
      + '<span class="reply-bar-content">' + htmlEncode(content) + '</span>'
      + '<button type="button" class="reply-bar-close" onclick="cancelReply()">✕</button>';
    bar.classList.add('active');
    document.getElementById('msgInput').focus();
  }
  function cancelReply() {
    replyTo = null;
    var bar = document.getElementById('replyBar');
    if (bar) {
      bar.classList.remove('active');
      bar.innerHTML = '';
    }
  }

  // ── Reacciones ──
  function toggleReaction(messageId, emoji) {
    acInvoke('ReactToMessage', messageId, recipientId, emoji);
  }
  function openReactionPicker(messageId, ev) {
    if (ev) ev.stopPropagation();
    var row = document.querySelector('.msg-row[data-id="' + messageId + '"]');
    if (!row) return;
    var existing = row.querySelector('.reaction-picker');
    if (existing) { existing.remove(); return; }
    var bar = document.createElement('div');
    bar.className = 'reaction-picker';
    ['👍','❤️','😂','😮','🙏'].forEach(function (e) {
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = e;
      b.className = 'reaction-pick';
      b.onclick = function () { bar.remove(); toggleReaction(messageId, e); };
      bar.appendChild(b);
    });
    var bubble = row.querySelector('.bubble');
    if (bubble) bubble.appendChild(bar);
  }
  function applyReaction(messageId, emoji, userId, added, count) {
    var row = document.querySelector('.msg-row[data-id="' + messageId + '"]');
    if (!row) return;
    var chip = row.querySelector('.reaction-chip[data-emoji="' + emoji + '"]');
    var mine = userId === currentUserId;
    if (added) {
      if (chip) {
        chip.querySelector('.rc-count').textContent = count;
        chip.classList.toggle('mine', mine);
      } else {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'reaction-chip' + (mine ? ' mine' : '');
        btn.setAttribute('data-emoji', emoji);
        btn.innerHTML = '<span class="rc-emoji">' + emoji + '</span><span class="rc-count">' + count + '</span>';
        btn.onclick = function () { toggleReaction(messageId, emoji); };
        var wrap = row.querySelector('.msg-reactions');
        if (!wrap) {
          wrap = document.createElement('div');
          wrap.className = 'msg-reactions';
          var b = row.querySelector('.bubble');
          if (b) b.appendChild(wrap);
        }
        if (wrap) wrap.appendChild(btn);
      }
    } else if (chip) {
      if (count > 0) {
        chip.querySelector('.rc-count').textContent = count;
        chip.classList.toggle('mine', mine);
      } else {
        chip.remove();
      }
    }
  }

  // ── Add message to DOM ──
  function addMessage(msg) {
    var area = document.getElementById('messages');
    var noMsg = area.querySelector('.no-messages');
    if (noMsg) noMsg.remove();

    var isMine = msg.senderId === currentUserId;
    var side = isMine ? 'mine' : 'theirs';

    var created = new Date(msg.createdAt);
    var dateKey = localDateKey(created);
    var lastDivider = area.querySelector('.date-divider:last-child');
    if (!lastDivider || lastDivider.getAttribute('data-date') !== dateKey) {
      var d = document.createElement('div');
      d.className = 'date-divider';
      d.setAttribute('data-date', dateKey);
      d.textContent = created.toLocaleDateString('es-GT', { day: 'numeric', month: 'long' });
      area.appendChild(d);
    }

    var avatarHtml = '';
    if (!isMine) {
      var aSrc = theirAvatar || '';
      if (aSrc) {
        avatarHtml = '<a href="/Profile/Index/' + msg.senderId + '"><img src="' + aSrc + '" class="avatar avatar-sm" alt=""/></a>';
      } else {
        avatarHtml = '<a href="/Profile/Index/' + msg.senderId + '"><span class="avatar avatar-sm" style="background:' + msg.senderColor + '">' + (msg.senderName || '?')[0] + '</span></a>';
      }
    }

    var replyHtml = '';
    if (msg.replyToId) {
      replyHtml = '<div class="msg-reply"><span class="msg-reply-sender">' + htmlEncode(msg.replyToSender || '') + '</span>'
        + '<span class="msg-reply-content">' + htmlEncode(msg.replyToContent || '') + '</span></div>';
    }

    var innerHtml = '';
    switch (normalizeType(msg.type)) {
      case 0: // Text
        innerHtml = '<span class="msg-text">' + htmlEncode(msg.content) + '</span>';
        break;
      case 1: // Image
        innerHtml = '<img src="' + msg.filePath + '" alt="' + htmlEncode(msg.fileName) + '" class="msg-image" onclick="openLightbox(this)"/>';
        break;
      case 5: // Sticker
        innerHtml = '<img src="' + msg.filePath + '" class="msg-sticker" alt="sticker"/>';
        break;
      case 2: // Audio
        innerHtml = '<div class="msg-audio"><span class="file-icon">🎵</span><div><div class="file-name">' + htmlEncode(msg.fileName) + '</div><audio controls src="' + msg.filePath + '"></audio></div></div>';
        break;
      case 4: // Video
        innerHtml = '<div class="msg-video"><video controls preload="metadata" src="' + msg.filePath + '"></video><div class="file-name">' + htmlEncode(msg.fileName) + '</div></div>';
        break;
      default: // Document
        innerHtml = '<div class="msg-doc"><span class="file-icon">📄</span><div><div class="file-name">' + htmlEncode(msg.fileName) + '</div><a href="' + msg.filePath + '" download="' + htmlEncode(msg.fileName) + '" class="file-download">Descargar</a></div></div>';
        break;
    }

    var seenHtml = '';
    if (isMine) {
      var seen = msg.readBy && msg.readBy.indexOf(recipientId) >= 0;
      seenHtml = '<span class="msg-seen">' + (seen ? '✓✓' : '✓') + '</span>';
    }
    var metaHtml = '<div class="msg-meta"><span class="msg-time">' + formatTime(msg.createdAt) + '</span>' + seenHtml + '</div>';

    var reactionsHtml = '';
    if (!msg.isDeleted) {
      var grouped = {};
      var mineSet = {};
      if (msg.reactions && msg.reactions.length) {
        msg.reactions.forEach(function (r) { grouped[r.emoji] = (grouped[r.emoji] || 0) + 1; });
        msg.reactions.forEach(function (r) { if (r.userId === currentUserId) mineSet[r.emoji] = 1; });
      }
      reactionsHtml = '<div class="msg-reactions">';
      Object.keys(grouped).forEach(function (e) {
        reactionsHtml += '<button class="reaction-chip' + (mineSet[e] ? ' mine' : '') + '" data-emoji="' + e + '" onclick="toggleReaction(\'' + msg.id + '\',\'' + e + '\')"><span class="rc-emoji">' + e + '</span><span class="rc-count">' + grouped[e] + '</span></button>';
      });
      reactionsHtml += '<button class="reaction-add" title="Reaccionar" onclick="openReactionPicker(\'' + msg.id + '\', event)">＋</button></div>';
    }

    var actionsHtml = '';
    if (!msg.isDeleted) {
      var preview = msg.type === 0 ? String(msg.content || '').slice(0, 40) : '[' + typeName(msg.type) + ']';
      actionsHtml = '<div class="msg-actions">'
        + '<button class="action-btn" title="Responder" onclick="respondTo(\'' + msg.id + '\',\'' + jsEncode(msg.senderName || '') + '\',\'' + jsEncode(preview) + '\')">↩</button>';
      if (isMine) {
        var editBtn = msg.type === 0 ? '<button class="action-btn" onclick="openEdit(\'' + msg.id + '\',\'' + jsEncode(msg.content) + '\')">✏</button>' : '';
        actionsHtml += editBtn + '<button class="action-btn del" onclick="confirmDelete(\'' + msg.id + '\')">🗑</button>';
      }
      actionsHtml += '</div>';
    }

    var bubble = document.createElement('div');
    bubble.className = 'bubble ' + side + (normalizeType(msg.type) === 5 ? ' sticker' : '');
    bubble.innerHTML = replyHtml + innerHtml + metaHtml + reactionsHtml + actionsHtml;

    var row = document.createElement('div');
    row.className = 'msg-row ' + side;
    row.setAttribute('data-id', msg.id);
    row.innerHTML = avatarHtml;
    row.appendChild(bubble);
    area.appendChild(row);
  }

  // ── Buscar en la conversación ──
  var searchTimer = null;
  function toggleSearch() {
    var panel = document.getElementById('searchPanel');
    var open = panel.hidden;
    panel.hidden = !open;
    if (open) {
      document.getElementById('searchInput').value = '';
      renderSearchResults([]);
      document.getElementById('searchInput').focus();
    }
  }
  function closeSearch() {
    document.getElementById('searchPanel').hidden = true;
    document.getElementById('searchInput').value = '';
  }
  document.addEventListener('DOMContentLoaded', function () {
    var inp = document.getElementById('searchInput');
    if (!inp) return;
    inp.addEventListener('input', function () {
      clearTimeout(searchTimer);
      var q = inp.value.trim();
      if (!q) { renderSearchResults([]); return; }
      searchTimer = setTimeout(function () { acInvoke('SearchMessages', recipientId, q); }, 300);
    });
    inp.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSearch(); });
  });
  function renderSearchResults(results) {
    var box = document.getElementById('searchResults');
    var count = document.getElementById('searchCount');
    if (!box) return;
    var inp = document.getElementById('searchInput');
    var q = inp ? inp.value.trim() : '';
    if (count) {
      count.hidden = results.length === 0;
      count.textContent = results.length + (results.length === 1 ? ' resultado' : ' resultados');
    }
    if (!results.length) {
      box.innerHTML = q
        ? '<div class="search-empty">Sin resultados para «' + htmlEncode(q) + '»</div>'
        : '<div class="search-empty">Escribí para buscar…</div>';
      return;
    }
    box.innerHTML = results.map(function (m) {
      var content = htmlEncode(m.content || '');
      if (q) content = highlightText(content, q);
      return '<div class="search-result" onclick="goToMessage(\'' + m.id + '\')">'
        + '<span class="search-result-avatar" style="background:' + htmlEncode(m.senderColor || '#6C63FF') + '">' + htmlEncode((m.senderName || '?').charAt(0).toUpperCase()) + '</span>'
        + '<span class="search-result-body">'
        + '<span class="search-result-name">' + htmlEncode(m.senderName || '') + '</span>'
        + '<span class="search-result-text">' + content + '</span>'
        + '</span>'
        + '<span class="search-result-time">' + formatTime(m.createdAt) + '</span></div>';
    }).join('');
  }
  function highlightText(text, q) {
    var needle = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    var re = new RegExp('(' + needle + ')', 'ig');
    return text.replace(re, '<mark class="search-hit">$1</mark>');
  }
  function goToMessage(id) {
    closeSearch();
    var row = document.querySelector('.msg-row[data-id="' + id + '"]');
    if (!row) return;
    row.scrollIntoView({ block: 'center' });
    row.classList.add('flash');
    setTimeout(function () { row.classList.remove('flash'); }, 1600);
  }

  // ── Edit / Delete via SignalR ──
  function submitEdit() {
    var mid = document.getElementById('editMsgId').value;
    var content = document.getElementById('editContent').value.trim();
    if (!content) return;
    acInvoke('EditMessage', mid, recipientId, content);
    closeModal('editModal');
  }

  function submitDelete() {
    var mid = document.getElementById('deleteMsgId').value;
    acInvoke('DeleteMessage', mid, recipientId);
    closeModal('deleteModal');
  }

  // ── Helpers ──
  function htmlEncode(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function jsEncode(s) {
    return s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
  }

  function formatTime(d) {
    var dt = new Date(d);
    return String(dt.getHours()).padStart(2,'0') + ':' + String(dt.getMinutes()).padStart(2,'0');
  }

  function localDateKey(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }

  function normalizeType(t) {
    if (typeof t === 'number') return t;
    switch (String(t).toLowerCase()) {
      case 'text': return 0;
      case 'image': return 1;
      case 'audio': return 2;
      case 'video': return 4;
      case 'sticker': return 5;
      default: return 3;
    }
  }

  function typeName(t) {
    var n = normalizeType(t);
    return n === 0 ? 'texto' : n === 1 ? 'imagen' : n === 2 ? 'audio' : n === 4 ? 'video' : n === 5 ? 'sticker' : 'archivo';
  }

  function scrollToBottom() {
    var msgs = document.getElementById('messages');
    if (msgs) msgs.scrollTop = msgs.scrollHeight;
  }

  // ── Attach ──
  function toggleAttach() { document.getElementById('attachPanel').classList.toggle('open'); }

  // ── Stickers ──
  var stickerOpen = false;

  function toggleStickers() {
    stickerOpen = !stickerOpen;
    var panel = document.getElementById('stickerPanel');
    panel.hidden = !stickerOpen;
    if (stickerOpen) loadStickers();
  }

  function loadStickers() {
    var body = document.getElementById('stickerPanelBody');
    if (body.dataset.loaded === '1') return;
    fetch('/Sticker/List')
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (items) {
        body.dataset.loaded = '1';
        if (!items.length) {
          body.innerHTML = '<div class="sticker-empty">No hay stickers aún. Importa un paquete pegando su link de sticker.ly.</div>';
          return;
        }
        body.innerHTML = items.map(function (s) {
          return '<button type="button" class="sticker-cell" onclick="sendSticker(\'' + s.path + '\')" title="' + htmlEncode(s.name) + '">' +
            '<img src="' + s.path + '" alt="' + htmlEncode(s.name) + '" loading="lazy"/></button>';
        }).join('');
      })
      .catch(function () {
        body.innerHTML = '<div class="sticker-empty">No se pudieron cargar los stickers</div>';
      });
  }

  function sendSticker(path) {
    stickerOpen = false;
    document.getElementById('stickerPanel').hidden = true;
    acInvoke('SendSticker', recipientId, path);
  }

  function importStickerPack() {
    var input = document.getElementById('stickerLink');
    var url = input.value.trim();
    if (!url) return;
    var btn = document.querySelector('.sticker-import-btn');
    var old = btn.textContent;
    btn.disabled = true;
    btn.textContent = '…';
    var fd = new FormData();
    fd.append('url', url);
    fetch('/Sticker/Import', { method: 'POST', body: fd })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (!res.ok) throw new Error(res.d.message || 'Error al importar');
        showToast('Paquete importado: ' + res.d.name + ' (' + res.d.count + ' stickers)', 'success');
        var body = document.getElementById('stickerPanelBody');
        body.dataset.loaded = '0';
        loadStickers();
        input.value = '';
      })
      .catch(function (err) { showToast('No se pudo importar: ' + err.message, 'error'); })
      .finally(function () { btn.disabled = false; btn.textContent = old; });
  }

  document.addEventListener('keydown', function (e) {
    if (stickerOpen && e.key === 'Enter' && e.target.id === 'stickerLink') {
      e.preventDefault();
      importStickerPack();
    }
  });

  document.addEventListener('click', function (e) {
    if (stickerOpen && !e.target.closest('#stickerPanel') && !e.target.closest('.icon-btn-sticker')) {
      stickerOpen = false;
      document.getElementById('stickerPanel').hidden = true;
    }
  });

  // Scroll to bottom on load
  scrollToBottom();
</script>
}
