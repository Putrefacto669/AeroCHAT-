@model RegisterViewModel
@{ ViewData["Title"] = "Registrarse"; Layout = "_Layout"; }

<div class="login-page">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-brand-icon">✈</div>
      <h1>AeroChat</h1>
      <p>Creá tu cuenta gratis</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
      <div class="alert-error">@Model.Error</div>
    }

    <form method="post" action="/Home/Register">
      <div class="field">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" value="@Model.Username"
               placeholder="nombre de usuario" autocomplete="username" required/>
      </div>
      <div class="field">
        <label for="displayName">Nombre a mostrar</label>
        <input type="text" id="displayName" name="displayName" value="@Model.DisplayName"
               placeholder="Cómo te van a ver los demás" required/>
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" placeholder="Mínimo 4 caracteres"
               autocomplete="new-password" required/>
      </div>
      <div class="field">
        <label for="confirmPassword">Confirmar contraseña</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repetí la contraseña"
               autocomplete="new-password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:4px">Crear cuenta</button>
    </form>

    <p class="login-note" style="margin-top:16px">
      ¿Ya tenés cuenta? <a href="/Home/Index" style="color:var(--accent);text-decoration:none;font-weight:600">Iniciá sesión</a>
    </p>
  </div>
</div>
