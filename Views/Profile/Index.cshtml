@model ProfileViewModel
@{
  ViewData["Title"] = Model.ProfileUser.DisplayName;
  var isOwn = Model.ProfileUser.Id == Model.CurrentUser.Id;
  ViewBag.SidebarActiveId = null;
}

<div class="app-shell">
  @await Html.PartialAsync("_Sidebar")

  <div class="profile-main">
    <div class="profile-header-bar">
      <button class="hamburger" onclick="openSidebar()" aria-label="Menú">☰</button>
      <span style="font-size:.9rem;color:var(--text-2)">Perfil</span>
    </div>

    <div class="profile-container">
      <div class="profile-banner" id="bannerDiv"
           style="@(!string.IsNullOrEmpty(Model.ProfileUser.BannerPath) ? $"background-image:url('{Model.ProfileUser.BannerPath}')" : "")">
        <div class="profile-banner-overlay"></div>
        @if (isOwn)
        {
          <form method="post" action="/Profile/UploadBanner" enctype="multipart/form-data" id="bannerForm">
            <button type="button" class="banner-edit-btn" onclick="document.getElementById('bannerFileInput').click()">
              🖼 Cambiar banner
            </button>
            <input type="file" id="bannerFileInput" name="bannerFile" accept="image/*" style="display:none"
                   onchange="document.getElementById('bannerForm').submit()"/>
          </form>
        }
      </div>

      <div class="profile-top">
        <div class="profile-avatar-wrap">
          @if (!string.IsNullOrEmpty(Model.ProfileUser.AvatarPath))
          {
            <img src="@Model.ProfileUser.AvatarPath" class="avatar avatar-lg" alt=""/>
          }
          else
          {
            <span class="avatar avatar-lg" style="background:@Model.ProfileUser.AvatarColor">@Model.ProfileUser.DisplayName[0]</span>
          }
          @if (isOwn)
          {
            <form method="post" action="/Profile/UploadAvatar" enctype="multipart/form-data" id="avatarForm">
              <button type="button" class="avatar-edit-btn" title="Cambiar foto" onclick="document.getElementById('avatarFileInput').click()">📷</button>
              <input type="file" id="avatarFileInput" name="avatarFile" accept="image/*" style="display:none"
                     onchange="document.getElementById('avatarForm').submit()"/>
            </form>
          }
        </div>

        <div class="profile-info-row">
          <div class="profile-name">
            @Model.ProfileUser.DisplayName
            <span class="presence-dot" data-userid="@Model.ProfileUser.Id"></span>
          </div>
          <div class="profile-username">
            @@@Model.ProfileUser.Username
            <span id="profileOnline" class="online-label"></span>
          </div>
          @if (!string.IsNullOrEmpty(Model.ProfileUser.Status))
          {
            <div class="profile-status">@Model.ProfileUser.Status</div>
          }
        </div>

        <div class="profile-btns" id="profileFriendActions"
             data-userid="@Model.ProfileUser.Id"
             data-isown="@(isOwn ? "1" : "0")"
             data-requestid="@Model.RequestId">
          @if (isOwn)
          {
            <a href="/Profile/Edit" class="btn btn-secondary">✏ Editar perfil</a>
          }
          else if (Model.FriendState == "friends")
          {
            <a href="/Chat/Conversation/@Model.ProfileUser.Id" class="btn btn-primary">💬 Mensaje</a>
            <button type="button" class="btn btn-secondary" onclick="removeFriend('@Model.ProfileUser.Id')">Eliminar amigo</button>
          }
          else if (Model.FriendState == "incoming")
          {
            <button type="button" class="btn btn-primary" onclick="acceptRequest('@Model.ProfileUser.Id','@Model.RequestId',this)">✓ Aceptar solicitud</button>
            <button type="button" class="btn btn-ghost" onclick="declineRequest('@Model.ProfileUser.Id','@Model.RequestId',this)">Rechazar</button>
          }
          else if (Model.FriendState == "outgoing")
          {
            <button type="button" class="btn btn-secondary" disabled>Solicitud enviada</button>
            <button type="button" class="btn btn-ghost" onclick="cancelRequest('@Model.ProfileUser.Id')">Cancelar</button>
          }
          else
          {
            <button type="button" class="btn btn-primary" onclick="sendFriendRequest('@Model.ProfileUser.Id')">＋ Agregar amigo</button>
          }
        </div>
      </div>

      @if (!string.IsNullOrEmpty(Model.YoutubeEmbedId))
      {
        <div class="profile-section">
          <div class="profile-section-title">🎵 Canción favorita</div>
          <div class="yt-wrap">
            <iframe src="https://www.youtube.com/embed/@Model.YoutubeEmbedId?rel=0&modestbranding=1"
                    title="Canción favorita" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
          </div>
        </div>
      }

      <div class="profile-section">
        <div class="profile-section-title">Amigos (@Model.Friends.Count)</div>
        @if (Model.Friends.Any())
        {
          <div class="friends-grid">
            @foreach (var f in Model.Friends)
            {
              <a href="/Profile/Index/@f.Id" class="friend-card" title="@f.DisplayName">
                <span class="avatar-wrap">
                  @if (!string.IsNullOrEmpty(f.AvatarPath))
                  {
                    <img src="@f.AvatarPath" class="avatar avatar-md" alt=""/>
                  }
                  else
                  {
                    <span class="avatar avatar-md" style="background:@f.AvatarColor">@f.DisplayName[0]</span>
                  }
                  <span class="presence-dot" data-userid="@f.Id"></span>
                </span>
                <span class="friend-card-name">@f.DisplayName</span>
              </a>
            }
          </div>
        }
        else
        {
          <div class="sidebar-empty">@(isOwn ? "Todavía no tenés amigos. Agregá gente desde el menú lateral." : "No tiene amigos todavía.")</div>
        }
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  var profileUserId = '@Model.ProfileUser.Id';
  function renderProfilePresence() {
    var online = !!window.acOnlineUsers[profileUserId];
    var el = document.getElementById('profileOnline');
    if (el) {
      el.textContent = online ? '· en línea' : '';
      el.classList.toggle('online', online);
    }
  }
  document.addEventListener('ac:presence', renderProfilePresence);
</script>
}
